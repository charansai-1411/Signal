# Copy this file to .env.local and paste your key. .env.local is gitignored.
#
# The app picks its LLM provider from these keys: GROQ_API_KEY is preferred,
# else OPENROUTER_API_KEY. Set ONE.

# --- Preferred: Groq (fast, free) --- https://console.groq.com/keys
GROQ_API_KEY=your_groq_key_here
# Fast open-source model that reliably catches contradictions (~2-3s end to end):
GROQ_MODEL=qwen/qwen3.8-27b

# --- Fallback: OpenRouter (free) --- https://openrouter.ai/keys
# OPENROUTER_API_KEY=your_key_here
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# --- Rooms (collaborative feature) ---
# Optional locally: without these, rooms use an in-memory dev store that works
# for a single `next dev` process but does NOT persist on Vercel. REQUIRED for
# real multi-device rooms and for any deployment. Create a free Redis DB at
# https://upstash.com and copy its REST URL + token.
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_token_here
